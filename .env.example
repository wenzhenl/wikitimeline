# Gemini API Key for timeline generation
GEMINI_API_KEY=your_gemini_key_here

# Vercel KV for caching (get these from Vercel dashboard)
KV_URL=your_kv_url_here
KV_REST_API_URL=your_kv_rest_api_url_here
KV_REST_API_TOKEN=your_kv_rest_api_token_here
KV_REST_API_READ_ONLY_TOKEN=your_kv_read_only_token_here

# API Security
# These two can be any string you want
# these are just passwords for your API to verify it's authorized requests
API_SECRET_KEY=your_api_secret_key_here
CLI_SECRET_KEY=your_cli_secret_key_here

# Contact email for timeline issues
NEXT_PUBLIC_CONTACT_EMAIL=your_contact_email_here

# Optional: Google Analytics
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=your_ga_id_here
